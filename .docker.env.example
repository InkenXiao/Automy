# ============================================================
# XIN-AI 容器环境变量示例
# 复制为 .docker.env 并按实际环境修改
#   cp .docker.env.example .docker.env
#
# 加入 ai_network 后, 可直接用容器名访问其他服务:
#   PostgreSQL : pg_db (端口 5432, 容器内端口)
#   Redis      : redis (端口 6379)
#   MinIO      : minio (端口 9000)
#   Neo4j      : neo4j (端口 7687)
#   Milvus     : milvus (端口 19530)
# ============================================================

# ---------- PostgreSQL 数据库 ----------
POSTGRES_HOST=pg_db
POSTGRES_PORT=5432
POSTGRES_DB=XIN
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=Siiit2026

# 完整连接 URL (优先级高于上面字段, 留空则由字段拼接)
# DATABASE_URL=postgresql+asyncpg://dbuser:Siiit2026@pg_db:5432/XIN

# ---------- 应用配置 ----------
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# ---------- 模型配置 (pro-cowork, 八通道按用途分离, OpenAI 兼容协议) ----------
# 容器内经 ai_network 访问 model-api 网关 (与 rag-app / mcp-hub 同一端点)

# 主推理模型 (智能体对话/会议纪要等主力生成)
MAIN_API_URL=http://model-api:3000/v1
MAIN_API_KEY=
MAIN_MODEL=LLM

# 轻量快推模型 (意图识别/内容润色/概括等快速任务; 未配置时回退主推理模型)
SMALL_API_URL=http://model-api:3000/v1
SMALL_API_KEY=
SMALL_MODEL=LLM

# 代码生成模型 (预留: AI coding)
CODER_API_URL=http://model-api:3000/v1
CODER_API_KEY=
CODER_MODEL=GLM

# 向量抽取模型 (知识库构建)
EMBEDDING_API_URL=http://model-api:3000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=EMBEDDING

# 结果重排模型 (RAG 重排)
RERANKER_API_URL=http://model-api:3000/v1
RERANKER_API_KEY=
RERANKER_MODEL=RERANKER

# 视觉多模态模型 (图片内容识别)
VISION_API_URL=http://model-api:3000/v1
VISION_API_KEY=
VISION_MODEL=VLM

# ASR 语音识别 (录音转文字)
ASR_API_URL=http://192.168.1.13:18888/v1/audio/transcriptions
ASR_API_KEY=
ASR_MODEL=paraformer-large
ASR_CHUNK_MS=120000

# TTS 语音合成 (文字合成语音, 预留)
TTS_API_URL=http://192.168.1.13:18888/v1/audio/transcriptions
TTS_API_KEY=
TTS_MODEL=paraformer-large
TTS_CHUNK_MS=10000

# mineru 算力网关 (扫描件 PDF 深度布局分析; ai_network 内容器名直达, 未部署则留空)
MINERU_API_URL=http://mineru:8000

# ---------- rag-cowork 知识库平台 (8092/8093) ----------
# Milvus 向量库 (ai_network 内容器名直达)
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_DB_NAME=default

# Neo4j 图数据库 (ai_network 内容器名直达)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MinIO 对象存储 (rag-cowork 知识库文件归档)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=xuanpu
MINIO_SECURE=false
MINIO_REGION=cn-north-1

# 知识库文件归档桶 (独立于 pro-cowork 的 xuanpu-pro 桶)
RAG_MINIO_BUCKET=xuanpu-rag

# 向量维度 (须与 model-api EMBEDDING 通道模型实际维度一致; 当前网关模型=2560)
EMBEDDING_DIM=2560

# ---------- 跨服务联动 (同容器内 localhost 直达) ----------
# 知识库 MCP 服务 (rag-cowork FastMCP; pro-cowork 知识库分身经此管理知识库)
KB_MCP_URL=http://localhost:8093/mcp
# 技链工坊 IM 推送接口 (mcp-cowork; pro-cowork send_im 工具经此推送个人 IM 通道)
MCP_IM_URL=http://localhost:8094/api/im/send
# 技链工坊工具巡检接口 (mcp-cowork; pro-cowork run_tool_inspection 工具经此触发巡检)
MCP_INSPECT_URL=http://localhost:8094/api/inspect
# 工具自动巡检间隔小时 (mcp-cowork; 0=关闭定时巡检)
INSPECT_INTERVAL_H=6

# 雪花 ID 工作节点
SNOWFLAKE_WORKER_ID=1
