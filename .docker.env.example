# ============================================================
# XIN-AI 容器环境变量示例
# 复制为 .docker.env 并按实际环境修改
#   cp .docker.env.example .docker.env
#
# 加入 ai_network 后, 可直接用容器名访问其他服务:
#   PostgreSQL : pg_db (端口 5432, 容器内端口)
#   Redis      : redis (端口 6379)
#   MinIO      : minio (端口 9000)
#   Neo4j      : neo4j (端口 7687)
#   Milvus     : milvus (端口 19530)
# ============================================================

# ---------- PostgreSQL 数据库 ----------
POSTGRES_HOST=pg_db
POSTGRES_PORT=5432
POSTGRES_DB=XIN
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=Siiit2026

# 完整连接 URL (优先级高于上面字段, 留空则由字段拼接)
# DATABASE_URL=postgresql+asyncpg://dbuser:Siiit2026@pg_db:5432/XIN

# ---------- 应用配置 ----------
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# ---------- LLM 配置 (Agent 引擎) ----------
# OpenAI 兼容 API, 支持 OpenAI / DeepSeek / 通义千问等
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
